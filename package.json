{
  "name": "massa-node-card",
  "version": "2.0.0",
  "description": "Home Assistant card for the Massa Node integration",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/card/massa-node-card.ts --bundle --minify --format=esm --target=es2020 --outfile=dist/massa-node-card.js",
    "watch": "npm run build -- --watch --sourcemap",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src"
  },
  "author": "firedream",
  "license": "ISC",
  "dependencies": {
    "lit": "^2.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
